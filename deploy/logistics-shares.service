[Unit]
Description=Logistics Network share links
After=network.target

[Service]
DynamicUser=yes
WorkingDirectory=/srv/logistics-network
Environment=ORIGIN=https://logistics-network.almanax21.com
Environment=PORT=8796
Environment=TRUST_PROXY=1
Environment=DB_PATH=/var/lib/logistics-shares/shares.db
Environment=SHARE_QUOTA_MB=256
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning shares/main.ts
Restart=on-failure
RestartSec=5
StateDirectory=logistics-shares
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=512M

[Install]
WantedBy=multi-user.target
